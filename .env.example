# ---------------------------------------------------------------------
# Base de datos: DigitalOcean → Databases → tu cluster → Connection details
# (elige "Connection string"). Termina en ?sslmode=require
DATABASE_URL=postgresql://doadmin:CLAVE@db-postgresql-nyc3-xxxxx.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# Opcional pero recomendado: certificado CA del cluster (botón "Download CA certificate").
# En App Platform se completa solo con ${tu-db.CA_CERT}
DATABASE_CA_CERT=

# Sesión: cadena aleatoria de 32+ caracteres. Genera una con:  openssl rand -base64 48
SESSION_SECRET=

# URL pública de la app (enlaces del ticket y del correo)
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Logos: DigitalOcean → Spaces Object Storage
SPACES_BUCKET=eventos-below
SPACES_REGION=nyc3
# API → Spaces Keys → Generate New Key
SPACES_KEY=
SPACES_SECRET=
# Opcional, si activas el CDN del Space:
SPACES_CDN_URL=

# ---------------------------------------------------------------------
# Correo de confirmación (Resend). Vacío = el correo se simula en los logs.
RESEND_API_KEY=
EMAIL_FROM="Eventos Below <eventos@tudominio.com>"
