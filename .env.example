# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública de la app (links del ticket y del correo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correo de confirmación (Resend). Si está vacío, el correo se simula en consola.
RESEND_API_KEY=
EMAIL_FROM="Eventos Below <eventos@tudominio.com>"
